# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic Console → API keys (used from Phase 2; server-side only, no NEXT_PUBLIC_ prefix)
ANTHROPIC_API_KEY=
# Your own login, used only by the Playwright sign-in test. Local only.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Which Claude model reads receipts (default: claude-haiku-5-5). Server-side only.
EXTRACTION_MODEL=claude-sonnet-5-5
